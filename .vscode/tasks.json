{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "prime-agent: build",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "-p", "pa-cli", "--bin", "prime-agent"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:HOME}/.cargo/bin:${env:PATH}"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      }
    },
    {
      "label": "prime-agent: run",
      "type": "shell",
      "command": "cargo",
      "args": ["run", "-p", "pa-cli", "--bin", "prime-agent"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:HOME}/.cargo/bin:${env:PATH}"
        }
      },
      "group": "none",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    }
  ]
}
